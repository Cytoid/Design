{
  "schemaVersion": 2,
  "id": "three-layer-example",
  "frames": {
    "ring": {
      "type": "circle",
      "r": 58.88,
      "stroke": {
        "palette": "ring"
      },
      "strokeWidth": 10.24
    },
    "core": {
      "type": "circle",
      "r": 43.52,
      "fill": {
        "palette": "fill"
      }
    }
  },
  "animations": {
    "clickVisual": {
      "layers": [
        {
          "source": {
            "frame": "ring"
          }
        },
        {
          "source": {
            "frame": "core"
          }
        }
      ]
    },
    "clickEnter": {
      "layers": [
        {
          "source": {
            "animation": "clickVisual"
          },
          "properties": {
            "transform": {
              "scale": {
                "track": "size"
              }
            },
            "opacity": {
              "track": "alpha"
            }
          }
        }
      ],
      "tracks": {
        "size": {
          "keys": [
            {
              "at": 0,
              "value": 0.32
            },
            {
              "at": 0.88,
              "value": 1.06,
              "ease": {
                "type": "bezier",
                "x1": 0.7,
                "y1": 0,
                "x2": 0.75,
                "y2": 1
              }
            },
            {
              "at": 0.98,
              "value": 1,
              "ease": {
                "type": "bezier",
                "x1": 0.7,
                "y1": 0,
                "x2": 0.75,
                "y2": 1
              }
            }
          ]
        },
        "alpha": {
          "keys": [
            {
              "at": 0,
              "value": 0
            },
            {
              "at": 0.3,
              "value": 1,
              "ease": {
                "type": "outCubic"
              }
            }
          ]
        }
      }
    },
    "clickExit": {
      "layers": [
        {
          "source": {
            "animation": "clickEnter",
            "sample": {
              "from": 1,
              "to": {
                "input": "exitRewindEnd"
              }
            }
          }
        }
      ],
      "tracks": {
        "fade": {
          "curve": "fade",
          "drop": 0.8,
          "fall": 1,
          "power": 3
        }
      },
      "properties": {
        "opacity": {
          "track": "fade"
        }
      },
      "isolate": true
    },
    "reverseFragment": {
      "layers": [
        {
          "at": 0.2,
          "until": 0.8,
          "source": {
            "animation": "clickEnter",
            "sample": {
              "from": 0.8,
              "to": 0.2
            }
          }
        }
      ]
    },
    "clickClear": {
      "tracks": {
        "size": {
          "keys": [
            {
              "at": 0,
              "value": 1
            },
            {
              "at": 1,
              "value": 2,
              "ease": {
                "type": "outCubic"
              }
            }
          ]
        },
        "alpha": {
          "keys": [
            {
              "at": 0,
              "value": 1
            },
            {
              "at": 1,
              "value": 0
            }
          ]
        }
      },
      "properties": {
        "transform": {
          "scale": {
            "track": "size"
          }
        },
        "opacity": {
          "track": "alpha"
        }
      },
      "isolate": true,
      "layers": [
        {
          "source": {
            "animation": "clickVisual"
          }
        }
      ]
    }
  },
  "slots": {
    "click:enter": {
      "animation": "clickEnter"
    },
    "click:exit": {
      "animation": "clickExit"
    },
    "click:clear:perfect": {
      "animation": "clickClear"
    },
    "click:clear:great": {
      "animation": "clickClear"
    },
    "click:clear:good": {
      "animation": "clickClear"
    },
    "click:clear:bad": {
      "animation": "clickClear"
    },
    "click-drag-head:enter": {
      "animation": "clickEnter"
    },
    "click-drag-head:exit": {
      "animation": "clickExit"
    },
    "click-drag-head:clear:perfect": {
      "animation": "clickClear"
    },
    "click-drag-head:clear:great": {
      "animation": "clickClear"
    },
    "click-drag-head:clear:good": {
      "animation": "clickClear"
    },
    "click-drag-head:clear:bad": {
      "animation": "clickClear"
    }
  },
  "name": "Three-layer skin example"
}
