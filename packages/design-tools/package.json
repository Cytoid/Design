{
  "name": "@cytoid/design-tools",
  "type": "module",
  "version": "0.0.0",
  "description": "Skin authoring, raster baking and texture export tools",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./authoring": {
      "types": "./dist/authoring.d.mts",
      "import": "./dist/authoring.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "bake": "node --import tsx scripts/bake.ts"
  },
  "dependencies": {
    "@cytoid/notes": "workspace:*",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "obuild": "^0.4.35",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
